{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leadpath",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/api/*",
      "/auth/*"
    ]
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "910245",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leadpath-db",
      "migrations_dir": "db/migrations"
    }
  ],
  "vars": {
    "BASE_URL": "https://leadpath.monty-08-raj.workers.dev",
    "BILLING_MODE": "disabled",
    "BILLING_WEBHOOKS_ENABLED": "false",
    "BILLING_LIVE_APPROVED": "false",
    "PAID_ENTITLEMENTS_ENABLED": "false",
    "MONITOR_MIN_INTERVAL_SECONDS": "21600",
    "SCHEDULER_BATCH_SIZE": "3",
    "SCHEDULED_CHECKS_PER_DAY": "288",
    "MANUAL_CHECKS_PER_DAY": "1000"
  },
  "previews": {
    "vars": {
      "BASE_URL": "https://leadpath-preview.invalid"
    },
    "ratelimits": [
      {
        "name": "RATE_LIMITER",
        "namespace_id": "910246",
        "simple": {
          "limit": 20,
          "period": 60
        }
      }
    ]
  }
}
