# Copy to .dev.vars (do not commit); use Cloudflare wrangler secret put for production.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
WEBHOOK_ENCRYPTION_KEY=64_LOWERCASE_HEX_DIGITS_32_BYTE_RANDOM_KEY
# Optional server-side alerts
TELEGRAM_BOT_TOKEN=
# Optional alternative OAuth provider for free workers.dev hosting
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Facebook Login (Meta Developers app with exact redirect URI)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional Sign in with X (OAuth 2.0 web app; X API access can incur charges)
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional email OTP via Resend: sender must be on a verified domain.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
# Generate a unique 32-byte key, 64 hex characters; do not reuse webhook key.
EMAIL_OTP_SECRET=

# Email/password + Brevo HTTPS API; sender must be verified for transactional emails.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=LeadPath
# Legacy one-time-code login is off by default.
ENABLE_EMAIL_OTP=false

# Supabase Auth for secure email/password (free Workers cannot perform password KDF locally).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Subscription foundation: disabled by default. Never use live secrets in local dev.
BILLING_MODE=disabled
BILLING_WEBHOOKS_ENABLED=false
BILLING_LIVE_APPROVED=false
PAID_ENTITLEMENTS_ENABLED=false
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# These settings may lower budgets; raising code ceilings needs capacity review.
MONITOR_MIN_INTERVAL_SECONDS=21600
SCHEDULER_BATCH_SIZE=3
SCHEDULED_CHECKS_PER_DAY=288
MANUAL_CHECKS_PER_DAY=1000
